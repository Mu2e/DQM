#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"

process_name : DQM

source : { module_type : RootInput }

services : @local::Services.Reco

physics:
{
  producers : {}
  analyzers : {
   # The input must come from STMDigisFromFragments with the raw and
   # zero-suppressed waveforms saved (saveRawWaveforms* and
   # saveZSWaveforms*, both off by default); otherwise set those tags to "".
   dqmStm : {
     module_type : DqmStm
     phHPGeTag: "makeSTMDigis:phHPGe"
     phLaBrTag: "makeSTMDigis:phLaBr"
     rawHPGeTag: "makeSTMDigis:rawHPGe"
     rawLaBrTag: "makeSTMDigis:rawLaBr"
     zsHPGeTag: "makeSTMDigis:zsHPGe"
     zsLaBrTag: "makeSTMDigis:zsLaBr"
     HPGefragSummaryTag: "makeSTMDigis:stmFragSummaryHPGe"
     LaBrfragSummaryTag: "makeSTMDigis:stmFragSummaryLaBr"

     digiTag : makeSTMDigis

   }
  }
  

 MyTrigPath : []
 MyEndPath : [dqmStm]

}

services.TFileService.fileName : "dqm_stm.root"